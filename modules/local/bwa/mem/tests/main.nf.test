nextflow_process {

    name "Test Process BWA_MEM"
    tag "modules_nfcore"
    tag "modules"
    tag "bwa"
    tag "bwa/mem"
    script "../main.nf"
    process "BWA_MEM"
    config "./nextflow.config"

    setup {
        run("BWA_INDEX") {
            script "../../index/main.nf"
            process {
                """
                input[0] = [
                    [id: 'test'],
                    file(params.local_test_data_base + 'references/Homo_sapiens_assembly38_chr20.fasta', checkIfExists: true)
                ]
                """
            }
        }
    }

    test("Paired-End") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test', single_end:false ], // meta map
                    [
                        file(params.local_test_data_base + 'fastqs/NA12878_chr20_R1.fastq.gz', checkIfExists: true),
                        file(params.local_test_data_base + 'fastqs/NA12878_chr20_R2.fastq.gz', checkIfExists: true)
                    ]
                ]
                input[1] = BWA_INDEX.out.index
                input[2] = [[id: 'test'],file(params.local_test_data_base + 'references/Homo_sapiens_assembly38_chr20.fasta', checkIfExists: true)]
                input[3] = false
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    process.out.cram,
                    process.out.csi,
                    process.out.crai,
                    process.out.findAll { key, val -> key.startsWith("versions") },
                    "bam_md5:${"md5 -q ${process.out.bam[0][1]}".execute().text.trim()}"
                    ).match()
                }
            )
        }

    }

    test("Paired-end - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test', single_end:false ], // meta map
                    [
                        file(params.local_test_data_base + 'fastqs/NA12878_chr20_R1.fastq.gz', checkIfExists: true),
                        file(params.local_test_data_base + 'fastqs/NA12878_chr20_R2.fastq.gz', checkIfExists: true)
                    ]
                ]
                input[1] = BWA_INDEX.out.index
                input[2] = [[id: 'test'],file(params.local_test_data_base + 'references/Homo_sapiens_assembly38_chr20.fasta', checkIfExists: true)]
                input[3] = false
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
